// The deterministic "what's on screen" snapshot, published on `st.agent.state`
// (ipc::channel) in reply to a GetUiState command. Assembled from StorageAccess +
// the controllers. This is the primary read path; frames are the fallback.
// See context/DESIGN_AGENT_UI_CONTROL.md.

include "agent_common.fbs";

namespace Sourcetrail.Agent;

// The currently visible dependency graph (StorageAccess::getGraphForActiveTokenIds).
table Graph {
    nodes: [NodeRef];
    edges: [EdgeRef];
}

// The code view (CodeController).
table CodeViewState {
    file_path:        string;
    scroll_line:      uint32;
    active_locations: [SourceLocationRef];
}

// TabInfo moved to agent_common.fbs (shared with the TabsChanged event).

table BookmarkInfo {
    bookmark_id: uint64;
    name:        string;
    comment:     string;
    category:    string;
}

table UiState {
    project_file_path: string;
    active_nodes:      [NodeRef];   // currently activated tokens
    graph:             Graph;       // visible dependency graph
    code_view:         CodeViewState;
    search_matches:    [SearchMatch];
    tabs:              [TabInfo];
    bookmarks:         [BookmarkInfo];
    error_total:       uint32;
    error_fatal:       uint32;
    indexing_active:   bool;
    app_state:         AppState = NoProject;   // the coarse application FSM state

    // Appended in protocol v3: what is in front of the app, waiting for an answer:
    // a modal window ("'title' (modal): text") or one of Sourcetrail's in-window
    // dialogs, by its title ("Start Indexing"). Empty when nothing is. An app
    // before v3 leaves it out, which would read as "nothing", hence the bump.
    dialog:            string;

    // Appended in protocol v6: the state machines remote control can drive (see
    // GetMachines), so one state read shows whether indexing waits for a mode or a
    // question for its answer.
    machines:          [MachineState];
}

// One message on `st.agent.state`. `request_id` echoes the GetUiState command's id.
table UiStateEnvelope {
    request_id: uint64;
    state:      UiState;
}

root_type UiStateEnvelope;
