// Common types shared by the agent-control channels.
// See context/DESIGN_AGENT_UI_CONTROL.md (transport: thoth-ipc + FlatBuffers).
//
// Sourcetrail identifies a symbol by its NameHierarchy, serialized to a stable
// string (`serialized_name`) that survives across sessions; the numeric `*_id`
// fields are session-local database element ids. Agents should address elements
// by serialized_name where possible; the controller resolves names to ids via
// StorageAccess (getNodeIdForNameHierarchy / getAutocompletionMatches).

namespace Sourcetrail.Agent;

// A graph node (class, function, file, ...).
table NodeRef {
    node_id:         uint64;   // 0 = unknown / unresolved
    serialized_name: string;   // NameHierarchy — canonical identity
    node_kind:       int32;    // NodeKind bitmask
    display_name:    string;   // human-friendly label (optional)
}

// A dependency edge between two nodes.
table EdgeRef {
    edge_id:                uint64;
    edge_type:              int32;   // Edge::EdgeType
    source_serialized_name: string;
    target_serialized_name: string;
}

// A source-code range in a file.
table SourceLocationRef {
    file_path:     string;
    start_line:    uint32;
    start_column:  uint32;
    end_line:      uint32;
    end_column:    uint32;
    location_type: int32;    // LocationType
}

// A single search-result match.
table SearchMatch {
    text:      string;    // matched (sub)string
    node_kind: int32;     // NodeKind
    node_ids:  [uint64];  // elements this match resolves to
    score:     int32;
}

// A UI tab (workspace): id, display title (primary symbol name), whether active.
table TabInfo {
    tab_id: uint64;
    title:  string;
    active: bool;
}

// Screen-space rectangle (structural UI geometry).
struct Rect { x: int32; y: int32; w: int32; h: int32; }

// One step in a UI-tree selector: pick the `index`-th sibling matching (role, name).
table PathStep { role: string; name: string; index: uint32; }

// A re-resolvable address of a UI element: an optional unique objectName anchor
// plus a role+name+index path. Emitted per node in a UI snapshot (UiNode.ref) and
// consumed by the structural-control commands (see DESIGN_AGENT_UI_SNAPSHOT.md).
table ElementRef { object_name: string; path: [PathStep]; }

// Coarse application state — the FSM the agent's control loop keys off. Derived
// from Sourcetrail's Project state + indexing; exposed on UiState.app_state and via
// the AppStateChanged event. Read state -> issue a valid command -> await the
// transition + a CommandResult.
enum AppState : byte {
    NoProject = 0,   // no project loaded
    Loading   = 1,   // a project is loading, until its first tab's first activation (v4)
    Indexing  = 2,   // indexing in progress
    Ready     = 3,   // project loaded and idle — browsable
    Busy      = 4    // processing (reserved)
}

// Agent-control protocol version. Bump `Current` whenever a schema arm is added
// (a new Command/Event). The handshake (GetInfo -> AppInfo) carries it so the bridge
// can detect skew against the app. Both the C++ app and the Rust bridge compile in
// the value from THIS schema copy, so a runtime difference means the two were built
// from different checkouts. See DESIGN_AGENT_UI_CONTROL.md (Protocol handshake).
//
// Also bump it when an older app would answer a command *silently wrong* (e.g.
// ignore a new field); a command an older app rejects as unknown fails loudly
// and needs no bump of its own. Versions:
//   1  the handshake (GetInfo -> AppInfo) and every command up to SetLogFilter
//   2  GetFrame answered (whole-screen composite) and its `region` crop
//   3  UiState.dialog; commands that only need the GUI thread (GetInfo, GetFrame,
//      GetSnapshot, QueryUi, InvokeAction, CaptureElement) no longer wait for
//      the message thread, so they answer while a dialog blocks it
//   4  AppState Loading is reported: from a load request until the load's first
//      tab has its first activation; navigation commands are refused meanwhile
//   5  SendInput (synthetic mouse / keyboard gestures), and GetFrame's ack
//      reports the frame's origin and scale in global coordinates
//   6  state machines: GetMachines, SendMachineEvent, the MachineTransition
//      event, and UiState.machines (an older app leaves it out, which would read
//      as "no machines")
enum ProtocolVersion : uint { Current = 6 }

enum RefreshMode : byte { None = 0, UpdatedFiles = 1, AllFiles = 2 }

enum ViewKind : byte { Unknown = 0, Graph = 1, Code = 2, Search = 3, Bookmarks = 4, Errors = 5 }

enum FrameFormat : byte { Png = 0, Jpeg = 1, RawRgba = 2 }

// Synthetic input (SendInput, protocol v5): the kind of one event of a gesture,
// and the button a press / release / double-click concerns.
enum InputEventKind : byte {
    MouseMove = 0,
    MousePress = 1,
    MouseRelease = 2,
    MouseDoubleClick = 3,
    Wheel = 4,
    KeyPress = 5,
    KeyRelease = 6
}
enum MouseButton : byte { NoButton = 0, Left = 1, Right = 2, Middle = 3 }

// A state machine as remote control sees it (protocol v6): what it is doing, the
// events it accepts from outside now, and a JSON object with what the state is
// about (the open question and its options, the files a mode would index, the
// indexing progress, the report). See DESIGN_AGENT_UI_CONTROL.md (State machines).
table MachineState {
    machine:  string;     // "indexing", "question"
    state:    string;
    events:   [string];   // accepted now from a dialog or an agent
    context:  string;     // JSON object
    revision: uint64;     // counts the machine's transitions
}

// Structural UI snapshot format (see agent_snapshot.fbs / DESIGN_AGENT_UI_SNAPSHOT.md).
enum SnapshotFormat : byte { Accessibility = 0, ObjectTree = 1 }

// Log forwarding (LogEvent / SetLogFilter). Level is a floor; source distinguishes
// Sourcetrail's LogManager from Qt's categorized logging.
enum LogLevel  : byte { Info = 0, Warning = 1, Error = 2 }
enum LogSource : byte { App = 0, Qt = 1 }
