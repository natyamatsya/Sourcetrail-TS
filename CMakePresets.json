				"rel",
				"windows-clang-cl-presets"
			]
		},
		{
			"name": "windows-clang-cl-reldbg",
			"inherits": [
				"reldbg",
				"windows-clang-cl-presets"
			]
		},
		{
			"name": "linux-gcc-dbg",
